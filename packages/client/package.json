{
  "name": "@sinema/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side code shared by the Expo apps (and later the kiosk): API client, session store, live seat updates. No native modules, so it never pulls a second copy of React Native into an app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinema/shared": "workspace:*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "@tanstack/react-query": "^5"
  }
}
