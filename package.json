{
  "name": "sinema",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "node packages/shared/node_modules/typescript/bin/tsc -p packages/shared",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sinema/api db:migrate",
    "db:seed": "pnpm --filter @sinema/api db:seed",
    "dev:api": "pnpm --filter @sinema/api dev",
    "dev:web": "pnpm --filter @sinema/web dev",
    "dev:mobile": "pnpm --filter @sinema/mobile start",
    "dev:staff": "pnpm --filter @sinema/staff start",
    "test": "pnpm --filter @sinema/api test",
    "typecheck": "pnpm -r typecheck"
  }
}
