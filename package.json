{
  "name": "sinema",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "pnpm --filter @sinema/shared build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @sinema/api dev",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @sinema/api db:migrate",
    "db:seed": "pnpm --filter @sinema/api db:seed"
  }
}
