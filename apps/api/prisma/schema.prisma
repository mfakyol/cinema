generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum SeatType {
  STANDARD
  /// A space for a wheelchair, sold like a seat.
  WHEELCHAIR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum TicketStatus {
  PAID
  USED
  CANCELLED
}

enum ProductCategory {
  COMBO
  SNACK
  DRINK
  /// 3D glasses; only sold for 3D showtimes.
  GLASSES
}

enum ShowFormat {
  TWO_D
  THREE_D
  IMAX
  IMAX_3D
}

enum PaymentMethod {
  CARD
  CASH
}

enum SalesChannel {
  WEB
  MOBILE
  KIOSK
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  orders  Order[]
  tickets Ticket[]
}

model Movie {
  id          String  @id @default(uuid())
  title       String
  description String
  durationMin Int
  genre       String
  posterUrl   String?
  tmdbId      Int?    @unique

  showtimes Showtime[]
}

model Hall {
  id       String       @id @default(uuid())
  name     String       @unique
  /// The seating plan the hall's seats were built from.
  layoutId String?
  /// What the hall's projector and screen can show; a showtime's format must be one of these.
  formats  ShowFormat[] @default([TWO_D])

  layout    HallLayout? @relation(fields: [layoutId], references: [id])
  seats     Seat[]
  showtimes Showtime[]
}

model Seat {
  id     String   @id @default(uuid())
  hallId String
  row    String
  number Int
  /// Position in the row counting aisles, from the hall layout, so maps can draw the gaps.
  column Int      @default(0)
  type   SeatType @default(STANDARD)

  hall    Hall       @relation(fields: [hallId], references: [id], onDelete: Cascade)
  locks   SeatLock[]
  tickets Ticket[]

  @@unique([hallId, row, number])
}

model Showtime {
  id       String     @id @default(uuid())
  movieId  String
  hallId   String
  startsAt DateTime
  /// Price in cents to avoid floating point money.
  price    Int
  format   ShowFormat @default(TWO_D)

  movie   Movie      @relation(fields: [movieId], references: [id])
  hall    Hall       @relation(fields: [hallId], references: [id])
  locks   SeatLock[]
  tickets Ticket[]

  @@index([hallId, startsAt])
}

/// A temporary hold on a seat while the holder pays. Rows past expiresAt are stale.
model SeatLock {
  id         String   @id @default(uuid())
  showtimeId String
  seatId     String
  /// User id, or a kiosk session id for guest purchases.
  holderId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id])

  @@unique([showtimeId, seatId])
  @@index([holderId])
  @@index([expiresAt])
}

/// One payment; groups the tickets bought together.
model Order {
  id             String      @id @default(uuid())
  holderId       String
  userId         String?
  /// Total in cents.
  amount         Int
  status         OrderStatus @default(PENDING)
  provider       String
  /// Box-office sales may be paid in cash; everything else is a card payment.
  paymentMethod  PaymentMethod @default(CARD)
  providerRef    String?
  idempotencyKey String      @unique
  /// Where the tickets and the order link are emailed; box-office buyers may skip it.
  contactEmail   String?
  /// Unguessable token in the order link, which shows the QR codes without signing in.
  accessToken    String      @unique
  createdAt      DateTime    @default(now())

  user    User?       @relation(fields: [userId], references: [id])
  tickets Ticket[]
  items   OrderItem[]
}

/// Unique (showtimeId, seatId) among non-cancelled tickets is a partial index
/// added by hand in the init migration, since Prisma cannot express it.
model Ticket {
  id         String       @id @default(uuid())
  orderId    String
  showtimeId String
  seatId     String
  userId     String?
  status     TicketStatus @default(PAID)
  qrToken    String       @unique
  channel    SalesChannel
  createdAt  DateTime     @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  showtime Showtime @relation(fields: [showtimeId], references: [id])
  seat     Seat     @relation(fields: [seatId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([showtimeId])
  @@index([userId])
}

/// Something sold at the concession stand: a snack, a drink, or a combo of them.
model Product {
  id          String          @id @default(uuid())
  /// Display name by language, e.g. {"en": "Large popcorn", "tr": "..."}.
  name        Json
  /// What a combo contains, by language.
  description Json?
  category    ProductCategory
  /// Price in cents.
  price       Int
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)

  orderItems OrderItem[]
}

/// One product line in an order, with the price it was sold at.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  /// Price in cents at the time of sale.
  unitPrice Int

  order    Order               @relation(fields: [orderId], references: [id])
  product  Product             @relation(fields: [productId], references: [id])
  vouchers ConcessionVoucher[]

  @@index([orderId])
}

/// One unit of a product to collect at the stand, with its own QR code, so items can be
/// collected separately or handed to friends. USED means collected.
model ConcessionVoucher {
  id          String       @id @default(uuid())
  orderItemId String
  qrToken     String       @unique
  status      TicketStatus @default(PAID)
  usedAt      DateTime?
  createdAt   DateTime     @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

/**
 * A reusable seating plan. `rows` is a JSON list of { label, cells } from the screen
 * backwards, where cells use S (standard), W (wheelchair) and _ (aisle).
 */
model HallLayout {
  id    String @id @default(uuid())
  name  String @unique
  rows  Json
  halls Hall[]
}
