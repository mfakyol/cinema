generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum SeatType {
  STANDARD
  /// A space for a wheelchair, sold like a seat.
  WHEELCHAIR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  /// Paid, then refunded: the showtime was cancelled or an admin refunded it.
  REFUNDED
}

enum TicketStatus {
  PAID
  USED
  CANCELLED
}

enum ProductCategory {
  COMBO
  SNACK
  DRINK
  /// 3D glasses; only sold for 3D showtimes.
  GLASSES
}

enum ShowFormat {
  TWO_D
  THREE_D
  IMAX
  IMAX_3D
}

enum PaymentMethod {
  CARD
  CASH
}

enum SalesChannel {
  WEB
  MOBILE
  KIOSK
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(CUSTOMER)
  /// Box-office lock PIN (staff and admin): a salt and SHA-256 digest the box office checks
  /// typed PINs against; see apps/api/src/lib/lock-pin.ts.
  lockPinSalt   String?
  lockPinDigest String?
  createdAt     DateTime @default(now())

  orders  Order[]
  tickets Ticket[]
}

model Movie {
  id          String  @id @default(uuid())
  title       String
  description String
  durationMin Int
  genre       String
  posterUrl   String?
  tmdbId      Int?    @unique

  showtimes Showtime[]
}

model Hall {
  id       String       @id @default(uuid())
  name     String       @unique
  /// The seating plan the hall's seats were built from.
  layoutId String?
  /// What the hall's projector and screen can show; a showtime's format must be one of these.
  formats  ShowFormat[] @default([TWO_D])

  layout    HallLayout? @relation(fields: [layoutId], references: [id])
  seats     Seat[]
  showtimes Showtime[]
}

model Seat {
  id     String   @id @default(uuid())
  hallId String
  row    String
  number Int
  /// Position in the row counting aisles, from the hall layout, so maps can draw the gaps.
  column Int      @default(0)
  type   SeatType @default(STANDARD)

  hall    Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([hallId, row, number])
}

model Showtime {
  id           String     @id @default(uuid())
  movieId      String
  hallId       String
  startsAt     DateTime
  /// Price in cents to avoid floating point money.
  price        Int
  format       ShowFormat @default(TWO_D)
  /// Set when an admin cancels the showtime; its paid orders are refunded at the same moment.
  cancelledAt  DateTime?
  cancelReason String?

  movie   Movie    @relation(fields: [movieId], references: [id])
  hall    Hall     @relation(fields: [hallId], references: [id])
  tickets Ticket[]
  orders  Order[]

  @@index([hallId, startsAt])
  /// The box office's day listing and the website's "upcoming" lists filter on start time.
  @@index([startsAt])
  @@index([movieId, startsAt])
}

/// One payment; groups the tickets bought together. A card payment is confirmed later by the
/// provider's webhook, so a PENDING order carries what to issue then: the showtime, the held
/// seats and the seat price at checkout. Status only moves PENDING -> PAID or PENDING -> FAILED,
/// always with a conditional UPDATE.
model Order {
  id            String        @id @default(uuid())
  holderId      String
  userId        String?
  /// Total in cents.
  amount        Int
  status        OrderStatus   @default(PENDING)
  provider      String
  /// Box-office sales may be paid in cash; everything else is a card payment.
  paymentMethod PaymentMethod @default(CARD)
  providerRef   String?
  showtimeId    String
  seatIds       String[]
  /// Seat price in cents after any discount, fixed at checkout.
  seatPrice     Int
  channel       SalesChannel
  /// Language of the confirmation email.
  locale        String        @default("en")
  /// Where the tickets and the order link are emailed; box-office buyers may skip it.
  contactEmail  String?
  /// Unguessable token in the order link, which shows the QR codes without signing in.
  accessToken   String        @unique
  createdAt     DateTime      @default(now())
  refundedAt    DateTime?
  refundReason  String?

  user     User?       @relation(fields: [userId], references: [id])
  showtime Showtime    @relation(fields: [showtimeId], references: [id])
  tickets  Ticket[]
  items    OrderItem[]

  @@index([holderId])
}

/// Unique (showtimeId, seatId) among non-cancelled tickets is a partial index
/// added by hand in the init migration, since Prisma cannot express it.
model Ticket {
  id         String       @id @default(uuid())
  orderId    String
  showtimeId String
  seatId     String
  userId     String?
  status     TicketStatus @default(PAID)
  qrToken    String       @unique
  channel    SalesChannel
  createdAt  DateTime     @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  showtime Showtime @relation(fields: [showtimeId], references: [id])
  seat     Seat     @relation(fields: [seatId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([showtimeId])
  @@index([userId])
}

/// Something sold at the concession stand: a snack, a drink, or a combo of them.
model Product {
  id          String          @id @default(uuid())
  /// Display name by language, e.g. {"en": "Large popcorn", "tr": "..."}.
  name        Json
  /// What a combo contains, by language.
  description Json?
  category    ProductCategory
  /// Price in cents.
  price       Int
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)

  orderItems OrderItem[]
}

/// One product line in an order, with the price it was sold at.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  /// Price in cents at the time of sale.
  unitPrice Int

  order    Order               @relation(fields: [orderId], references: [id])
  product  Product             @relation(fields: [productId], references: [id])
  vouchers ConcessionVoucher[]

  @@index([orderId])
}

/// One unit of a product to collect at the stand, with its own QR code, so items can be
/// collected separately or handed to friends. USED means collected.
model ConcessionVoucher {
  id          String       @id @default(uuid())
  orderItemId String
  qrToken     String       @unique
  status      TicketStatus @default(PAID)
  usedAt      DateTime?
  createdAt   DateTime     @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

/**
 * A reusable seating plan. `rows` is a JSON list of { label, cells } from the screen
 * backwards, where cells use S (standard), W (wheelchair) and _ (aisle).
 */
model HallLayout {
  id    String @id @default(uuid())
  name  String @unique
  rows  Json
  halls Hall[]
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// One per Idempotency-Key a caller sent. The first request inserts the row and does the work;
/// a repeat returns the stored response, or 409 while the first is still running. The request
/// hash catches a key reused for a different request.
model IdempotencyKey {
  holderId       String            @map("holder_id")
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@id([holderId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// A payment provider event already handled. Inserted with ON CONFLICT DO NOTHING in the same
/// transaction as the order update, so a redelivered webhook changes nothing.
model ProcessedWebhook {
  provider   String
  eventId    String   @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@id([provider, eventId])
  @@map("processed_webhooks")
}

/// A message a consumer already handled, keyed by the outbox row id. Written in the same
/// transaction as the consumer's work; the message is acked only after the commit.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, messageId])
  @@map("processed_messages")
}

/// Events written in the same transaction as the change they describe, then published to
/// RabbitMQ by the relay, which marks them published. Unpublished rows have a partial index
/// (added by hand in the migration).
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@map("outbox")
}

enum PrintJobStatus {
  QUEUED
  PRINTED
}

/// A box-office ticket to print. Holds only the ticket reference; the printout is drawn from
/// the ticket when the printer takes the job.
model PrintJob {
  id        String         @id @default(uuid())
  ticketId  String         @unique @map("ticket_id")
  status    PrintJobStatus @default(QUEUED)
  createdAt DateTime       @default(now()) @map("created_at")
  printedAt DateTime?      @map("printed_at")

  @@map("print_jobs")
}

/// Sales per cinema day and channel, kept up to date by the stats worker.
model DailySales {
  day     DateTime     @db.Date
  channel SalesChannel
  orders  Int          @default(0)
  tickets Int          @default(0)
  items   Int          @default(0)
  /// Revenue in cents.
  revenue Int          @default(0)
  /// Refunded in cents, counted on the day of the refund.
  refunds Int          @default(0)

  @@id([day, channel])
  @@map("daily_sales")
}
